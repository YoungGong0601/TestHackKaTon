  m_text: "\uC0C1\uC601 \uC2DC\uAC04\uD45C\uB294 \uADF9\uC7A5 \uC0AC\uC815\uC5D0
    \uB530\uB77C \uBCC0\uACBD\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC608\uB9E4
    \uCDE8\uC18C\uB294 \uC0C1\uC601 \uC2DC\uC791 20\uBD84 \uC804\uAE4C\uC9C0 \uAC00\uB2A5\uD569\uB2C8\uB2E4.
    \uC785\uC7A5 \uC9C0\uC5F0 \uC2DC \uAD00\uB78C\uC774 \uC81C\uD55C\uB420 \uC218
    \uC788\uC2B5\uB2C8\uB2E4. \uC678\uBD80 \uC74C\uC2DD \uBC18\uC785\uC740 \uC77C\uBD80
    \uC81C\uD55C\uB429\uB2C8\uB2E4. \uBA64\uBC84\uC2ED \uC57D\uAD00 \uC81C12\uC870\uC5D0
    \uB530\uB77C \uC801\uB9BD\uC740 \uC775\uC601\uC5C5\uC77C\uC5D0 \uBC18\uC601\uB429\uB2C8\uB2E4.
    \uC81C\uD734 \uD560\uC778\uACFC \uCFE0\uD3F0 \uC911\uBCF5 \uBD88\uAC00. \uD560\uC778\uAD8C\uC740
    \uD604\uC7A5 \uBC1C\uAD8C\uC5D0 \uD55C\uD569\uB2C8\uB2E4. \uC0C1\uC601 \uC2DC\uAC04\uD45C\uB294
    \uADF9\uC7A5 \uC0AC\uC815\uC5D0 \uB530\uB77C \uBCC0\uACBD\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
