    \uC720\uBC1C \uC131\uBD84\uC740 \uB9E4\uC7A5 \uB0B4 \uAC8C\uC2DC\uBB3C\uC744
    \uCC38\uACE0\uD574 \uC8FC\uC2ED\uC2DC\uC624. \uC6D0\uB450 \uC6D0\uC0B0\uC9C0(\uBE0C\uB77C\uC9C8,
    \uCF5C\uB86C\uBE44\uC544, \uC5D0\uD2F0\uC624\uD53C\uC544) \uC6B0\uC720(\uAD6D\uB0B4\uC0B0)
    \uC77C\uBD80 \uB9E4\uC7A5 \uC81C\uC678. \uBA64\uBC84\uC2ED \uC57D\uAD00 \uC81C12\uC870\uC5D0
    \uB530\uB77C \uC801\uB9BD\uC740 \uC775\uC601\uC5C5\uC77C\uC5D0 \uBC18\uC601\uB429\uB2C8\uB2E4.
    \uC81C\uD734 \uD560\uC778 \uC911\uBCF5 \uBD88\uAC00. \uC77C\uD68C\uC6A9 \uCEF5
    \uBCF4\uC99D\uAE08\uC740 \uBCC4\uB3C4\uC785\uB2C8\uB2E4. "
