--- !u!114 &3557587777429450425
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 323043045597011655}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.7019608, g: 0.63529414, b: 0.53333336, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 16
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 0
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.05
  m_Text: "\uBCF8 \uC774\uBBF8\uC9C0\uB294 \uC5F0\uCD9C\uB41C \uAC83\uC73C\uB85C
    \uC2E4\uC81C\uC640 \uB2E4\uB97C \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC77C\uBD80
    \uB9E4\uC7A5 \uC81C\uC678. \uC54C\uB808\uB974\uAE30 \uC720\uBC1C \uC131\uBD84\uACFC
    \uC6D0\uC0B0\uC9C0 \uC815\uBCF4\uB294 \uB9E4\uC7A5 \uB0B4 \uAC8C\uC2DC\uBB3C\uC744
    \uCC38\uACE0\uD574 \uC8FC\uC2ED\uC2DC\uC624. \uC1E0\uACE0\uAE30(\uD638\uC8FC\uC0B0,
    \uB274\uC9C8\uB79C\uB4DC\uC0B0) \uB2ED\uACE0\uAE30(\uAD6D\uB0B4\uC0B0, \uBE0C\uB77C\uC9C8\uC0B0)
    \uC300(\uAD6D\uB0B4\uC0B0) \uBA64\uBC84\uC2ED \uC57D\uAD00 \uC81C12\uC870\uC5D0
    \uB530\uB77C \uC801\uB9BD\uC740 \uC775\uC601\uC5C5\uC77C\uC5D0 \uBC18\uC601\uB429\uB2C8\uB2E4.
    \uC81C\uD734 \uD560\uC778 \uC911\uBCF5 \uBD88\uAC00. \uBCF8 \uC774\uBBF8\uC9C0\uB294
    \uC5F0\uCD9C\uB41C \uAC83\uC73C\uB85C \uC2E4\uC81C\uC640 \uB2E4\uB97C \uC218
    \uC788\uC2B5\uB2C8\uB2E4. \uC77C\uBD80 \uB9E4\uC7A5 \uC81C\uC678. \uC54C\uB808\uB974\uAE30
    \uC720\uBC1C \uC131\uBD84\uACFC \uC6D0\uC0B0\uC9C0 \uC815\uBCF4\uB294 \uB9E4\uC7A5
    \uB0B4 \uAC8C\uC2DC\uBB3C\uC744 \uCC38\uACE0\uD574 \uC8FC\uC2ED\uC2DC\uC624.
    \uC1E0\uACE0\uAE30(\uD638\uC8FC\uC0B0, \uB274\uC9C8\uB79C\uB4DC\uC0B0) \uB2ED\uACE0\uAE30(\uAD6D\uB0B4\uC0B0,
    \uBE0C\uB77C\uC9C8\uC0B0) \uC300(\uAD6D\uB0B4\uC0B0) \uBA64\uBC84\uC2ED \uC57D\uAD00
    \uC81C12\uC870\uC5D0 \uB530\uB77C \uC801\uB9BD\uC740 \uC775\uC601\uC5C5\uC77C\uC5D0
    \uBC18\uC601\uB429\uB2C8\uB2E4. \uC81C\uD734 \uD560\uC778 \uC911\uBCF5 \uBD88\uAC00."
